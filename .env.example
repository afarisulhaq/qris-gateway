PORT=3100
HOST=127.0.0.1
APP_URL=http://localhost:5173
DATA_DIR=./data

# bun run setup creates random values. Keep ENCRYPTION_KEY stable for stored gateway secrets.
SETUP_TOKEN=
ENCRYPTION_KEY=

# Only for reconciling historical invoices from external gateways. Managed wallets use private loopback children.
GATEWAY_ALLOWED_HOSTS=localhost:3000,localhost:3001,127.0.0.1:3000,127.0.0.1:3001

# Choose the managed operator wallet in Admin, not via external gateway credentials.
# Optional absolute path to Node >=18, otherwise the Node executable on PATH is used.
# GATEWAY_NODE_BINARY=/usr/bin/node
# Optional private wallet directory, otherwise DATA_DIR/wallets.
# GATEWAY_DATA_DIR=

# Optional exact SQLite filename, otherwise DATA_DIR/qris.sqlite.
# DATABASE_PATH=
