{
  "name": "qris-gateway",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "setup": "bun run scripts/setup.ts",
    "gateways:install": "bun run scripts/install-gateways.ts",
    "dev": "bun run scripts/dev.ts",
    "dev:api": "bun --watch server/index.ts",
    "dev:ui": "vite --host 127.0.0.1",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "start": "NODE_ENV=production bun server/index.ts",
    "test": "bun test"
  },
  "dependencies": {
    "@zxing/browser": "^0.1.5",
    "elysia": "^1.4.0",
    "qrcode": "^1.5.4",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@types/bun": "^1.3.0",
    "@types/qrcode": "^1.5.5",
    "svelte-check": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
